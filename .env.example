PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/portal_busway
MQTT_BROKER_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=capstoneb05
MQTT_PASSWORD=your-local-mosquitto-password
CAMERA_FRAME_TOKEN=local-camera-token-123
RTSP_PUBLISH_ENABLED=true
RTSP_FFMPEG_PATH=ffmpeg
RTSP_OUTPUT_BASE_URL=rtsp://127.0.0.1:8554/cameras
RTSP_FPS=10
TRACKER_IOU_THRESHOLD=0.4
TRACKER_MAX_MISSED_FRAMES=5
TRACKER_MAX_INACTIVE_MS=3000
FRAME_QUEUE_SIZE=3
MAX_FRAME_BYTES=1048576
ONNX_DETECTOR_MODULE=./onnxDetector.js
ONNX_MODEL_PATH=assets/models/model-portal.onnx
ONNX_CONFIDENCE_THRESHOLD=0.25
ONNX_VEHICLE_TYPE=bus
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
