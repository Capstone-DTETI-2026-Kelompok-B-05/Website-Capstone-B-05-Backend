{
  "name": "capstone-b05-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server.js",
    "start": "node server.js",
    "test:mqtt": "node test-mqtt.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPatterns=tests/mqtt.integration.test.js",
    "load:api": "artillery run load-tests/artillery-api.yml",
    "load:mqtt": "artillery run load-tests/artillery-mqtt.yml",
    "load:test": "npm run load:api && npm run load:mqtt"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.19.1",
    "morgan": "^1.10.0",
    "mqtt": "^5.16.0"
  },
  "devDependencies": {
    "artillery": "^2.0.33",
    "artillery-engine-mqtt": "^1.2.3",
    "jest": "^30.5.2",
    "supertest": "^7.3.1"
  }
}
